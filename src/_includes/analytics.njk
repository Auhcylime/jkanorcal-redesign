{% if site.ga_id %}
<!-- Google Analytics 4 (gtag) with Consent Mode v2 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  // Default to denied until the visitor chooses (EEA-friendly). Until then GA
  // sends cookieless, anonymous pings so aggregate traffic is still measured.
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied',
    ad_personalization: 'denied', analytics_storage: 'denied'
  });
  gtag('config', '{{ site.ga_id }}');
  (function(){ try {
    if (localStorage.getItem('jka-consent') === 'granted')
      gtag('consent', 'update', { analytics_storage: 'granted' });
  } catch(e){} })();

  // Lightweight cookie-consent banner (shown once, until a choice is stored).
  document.addEventListener('DOMContentLoaded', function(){
    try { if (localStorage.getItem('jka-consent')) return; } catch(e){ return; }
    var bar = document.createElement('div');
    bar.setAttribute('role','dialog');
    bar.setAttribute('aria-label','Cookie consent');
    bar.style.cssText = "position:fixed;left:20px;right:20px;bottom:20px;z-index:9999;max-width:600px;margin:0 auto;background:#ffffff;color:#2d2a26;border:1px solid #e4e1db;border-radius:8px;padding:18px 20px;font-family:'DM Sans',-apple-system,system-ui,sans-serif;font-size:0.9rem;line-height:1.6;box-shadow:0 14px 44px rgba(0,0,0,0.14);display:flex;gap:16px;align-items:center;flex-wrap:wrap";
    bar.innerHTML = '<span style="flex:1;min-width:220px;color:#4a453e">We use cookies to measure site traffic. <a href="/privacy" style="color:#c8102e;text-decoration:underline;text-underline-offset:2px">Learn more</a>.</span>';
    function btn(label, grant){
      var b = document.createElement('button');
      b.textContent = label;
      b.style.cssText = "border-radius:4px;padding:9px 20px;font-family:'DM Sans',-apple-system,sans-serif;font-size:0.85rem;font-weight:500;cursor:pointer;transition:background .2s,color .2s,border-color .2s;" + (grant ? 'background:#c8102e;color:#fff;border:1px solid #c8102e' : 'background:transparent;color:#7a756e;border:1px solid #e4e1db');
      b.onmouseenter = function(){ if (grant) { b.style.background = '#e62e44'; b.style.borderColor = '#e62e44'; } else { b.style.background = '#f8f7f4'; b.style.color = '#2d2a26'; b.style.borderColor = '#7a756e'; } };
      b.onmouseleave = function(){ if (grant) { b.style.background = '#c8102e'; b.style.borderColor = '#c8102e'; } else { b.style.background = 'transparent'; b.style.color = '#7a756e'; b.style.borderColor = '#e4e1db'; } };
      b.onclick = function(){
        try { localStorage.setItem('jka-consent', grant ? 'granted' : 'denied'); } catch(e){}
        if (grant) gtag('consent', 'update', { analytics_storage: 'granted' });
        bar.remove();
      };
      return b;
    }
    bar.appendChild(btn('Decline', false));
    bar.appendChild(btn('Accept', true));
    document.body.appendChild(bar);
  });
</script>
{% endif %}
