{% if site.ga_id %}
<!-- Google Analytics 4 (gtag) with Consent Mode v2 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  // Default to denied until the visitor chooses (EEA-friendly). Until then GA
  // sends cookieless, anonymous pings so aggregate traffic is still measured.
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied',
    ad_personalization: 'denied', analytics_storage: 'denied'
  });
  gtag('config', '{{ site.ga_id }}');
  (function(){ try {
    if (localStorage.getItem('jka-consent') === 'granted')
      gtag('consent', 'update', { analytics_storage: 'granted' });
  } catch(e){} })();

  // Lightweight cookie-consent banner (shown once, until a choice is stored).
  document.addEventListener('DOMContentLoaded', function(){
    try { if (localStorage.getItem('jka-consent')) return; } catch(e){ return; }
    var bar = document.createElement('div');
    bar.setAttribute('role','dialog');
    bar.setAttribute('aria-label','Cookie consent');
    // Full-width bar pinned to the bottom, mirroring the header nav
    // (edge-to-edge, same side padding, translucent white + blur, hairline border).
    bar.style.cssText = "position:fixed;left:0;right:0;bottom:0;z-index:9999;background:rgba(255,255,255,0.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:#2d2a26;border-top:1px solid rgba(0,0,0,0.06);box-shadow:0 -6px 24px rgba(45,42,38,0.06);padding:16px var(--side-pad,clamp(24px,5vw,60px));font-family:'DM Sans',-apple-system,system-ui,sans-serif;font-size:0.9rem;line-height:1.6;display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap";
    bar.innerHTML = '<span style="flex:1;min-width:220px;color:#4a453e">We use cookies to measure site traffic. <a href="/privacy" style="color:#c8102e;text-decoration:underline;text-underline-offset:2px">Learn more</a>.</span>';
    function btn(label, grant){
      var b = document.createElement('button');
      b.textContent = label;
      // Mirror the site .btn / .btn-accent / .btn-outline system exactly,
      // including the signature hover lift (translateY + soft shadow).
      b.style.cssText = "padding:12px 26px;font-family:'DM Sans',-apple-system,sans-serif;font-size:0.82rem;font-weight:500;line-height:1;border-radius:4px;cursor:pointer;transition:transform .35s cubic-bezier(0.2,0.8,0.2,1),box-shadow .35s cubic-bezier(0.2,0.8,0.2,1),background .25s ease,border-color .25s ease,color .25s ease;" + (grant ? 'background:#c8102e;color:#fff;border:1px solid #c8102e' : 'background:transparent;color:#4a453e;border:1px solid #e4e1db');
      b.onmouseenter = function(){
        b.style.transform = 'translateY(-2px)';
        b.style.boxShadow = '0 8px 22px rgba(0,0,0,0.12)';
        if (grant) { b.style.background = '#e62e44'; b.style.borderColor = '#e62e44'; }
        else { b.style.background = '#ffffff'; b.style.color = '#2d2a26'; b.style.borderColor = '#2d2a26'; }
      };
      b.onmouseleave = function(){
        b.style.transform = 'none';
        b.style.boxShadow = 'none';
        if (grant) { b.style.background = '#c8102e'; b.style.borderColor = '#c8102e'; }
        else { b.style.background = 'transparent'; b.style.color = '#4a453e'; b.style.borderColor = '#e4e1db'; }
      };
      b.onclick = function(){
        try { localStorage.setItem('jka-consent', grant ? 'granted' : 'denied'); } catch(e){}
        if (grant) gtag('consent', 'update', { analytics_storage: 'granted' });
        bar.remove();
      };
      return b;
    }
    bar.appendChild(btn('Decline', false));
    bar.appendChild(btn('Accept', true));
    document.body.appendChild(bar);
  });
</script>
{% endif %}
