{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "framework": null,
  "redirects": [
    { "source": "/about-us", "destination": "/#about", "permanent": true },
    { "source": "/about-us/privacy-policy", "destination": "/privacy.html", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/schedule", "destination": "/#schedule", "permanent": true },
    { "source": "/classes", "destination": "/#schedule", "permanent": true },
    { "source": "/instructors", "destination": "/sensei.html", "permanent": true },
    { "source": "/sensei", "destination": "/sensei.html", "permanent": true },
    { "source": "/contact", "destination": "/#location", "permanent": true },
    { "source": "/visit", "destination": "/#location", "permanent": true },
    { "source": "/location", "destination": "/#location", "permanent": true },
    { "source": "/camp", "destination": "/camp.html", "permanent": true },
    { "source": "/join", "destination": "/join.html", "permanent": true },
    { "source": "/register", "destination": "/join.html", "permanent": true },
    { "source": "/interview", "destination": "/interview.html", "permanent": true },
    { "source": "/newsletter", "destination": "/newsletter.html", "permanent": true },
    { "source": "/newsletters", "destination": "/newsletter.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy.html", "permanent": true },
    { "source": "/archives/:path*", "destination": "/", "permanent": true }
  ]
}
